---
layout: layouts/base.njk
title: Work
description: Portfolio case studies and shipped products.
---
<section class="section">
  <div class="container">
    <p class="eyebrow">Portfolio</p>
    <h1>Case studies</h1>
    <p class="section-subtitle">A few product-focused projects with design, frontend architecture, and measurable outcomes.</p>

    <div class="work-grid">
      {% for project in collections.work | reverse %}
        <article class="card">
          <h2><a href="{{ project.url | url }}">{{ project.data.title }}</a></h2>
          <span class="meta">{{ project.data.stack }}</span>
          <p>{{ project.data.summary }}</p>
          {% if project.data.link %}
            <p><a href="{{ project.data.link }}" target="_blank" rel="noopener noreferrer">Live preview</a></p>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>
