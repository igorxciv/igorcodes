<div class="fm-page">
  <section id="hero" class="fm-hero">
    <div class="fm-hero-content">
      <p class="fm-role">PRINCIPAL SOFTWARE ENGINEER</p>
      <h1 class="fm-name">Alex Chen</h1>
      <p class="fm-tagline">Building distributed systems that help people learn, create, and connect.</p>
      <nav class="fm-hero-links" aria-label="Hero links">
        <a href="#projects">View Work</a>
        <span aria-hidden="true">•</span>
        <a href="#contact">Get in Touch</a>
      </nav>
    </div>
    <a href="#timeline" class="fm-scroll-down" aria-label="Scroll down">
      {% lucide "chevronDown" %}
    </a>
  </section>

  <section id="timeline" class="fm-section">
    <div class="fm-container">
      <header class="fm-section-head fm-reveal">
        <h2>Career Journey</h2>
        <p>A decade of building systems and leading teams</p>
      </header>

      <div class="fm-timeline" data-timeline>
        <span class="fm-timeline-line" aria-hidden="true"></span>
        <span class="fm-timeline-progress" data-timeline-progress aria-hidden="true"></span>

        <article class="fm-timeline-item fm-timeline-item-left fm-reveal">
          <div class="fm-timeline-copy">
            <p class="fm-year">2026</p>
            <h3>Principal Software Engineer</h3>
            <p>Leading architecture and technical strategy for large-scale distributed systems. Mentoring teams across the organization.</p>
          </div>
          <span class="fm-timeline-dot" aria-hidden="true"></span>
        </article>

        <article class="fm-timeline-item fm-timeline-item-right fm-reveal">
          <div class="fm-timeline-copy">
            <p class="fm-year">2023</p>
            <h3>Staff Engineer</h3>
            <p>Designed and implemented microservices infrastructure serving millions of users. Led cross-functional initiatives.</p>
          </div>
          <span class="fm-timeline-dot" aria-hidden="true"></span>
        </article>

        <article class="fm-timeline-item fm-timeline-item-left fm-reveal">
          <div class="fm-timeline-copy">
            <p class="fm-year">2020</p>
            <h3>Senior Engineer</h3>
            <p>Built scalable APIs and data pipelines. Introduced modern DevOps practices and CI/CD workflows.</p>
          </div>
          <span class="fm-timeline-dot" aria-hidden="true"></span>
        </article>

        <article class="fm-timeline-item fm-timeline-item-right fm-reveal">
          <div class="fm-timeline-copy">
            <p class="fm-year">2017</p>
            <h3>Software Engineer</h3>
            <p>Developed full-stack applications using React and Node.js. Contributed to open-source projects.</p>
          </div>
          <span class="fm-timeline-dot" aria-hidden="true"></span>
        </article>
      </div>
    </div>
  </section>

  <section id="projects" class="fm-section">
    <div class="fm-container">
      <header class="fm-section-head fm-reveal">
        <h2>Selected Work</h2>
        <p>Highlighting impactful projects from recent years</p>
      </header>

      <div class="fm-grid fm-grid-two">
        <article class="fm-card fm-project-card fm-reveal">
          <a href="{{ '/work/' | url }}" class="fm-project-link" aria-label="Open Cloud Infrastructure Platform">
            {% lucide "squareArrowOutUpRight" %}
          </a>
          <h3>Cloud Infrastructure Platform</h3>
          <p>Designed and built a multi-region Kubernetes infrastructure serving 10M+ daily active users with 99.99% uptime.</p>
          <ul class="fm-tags">
            <li>Kubernetes</li>
            <li>AWS</li>
            <li>Terraform</li>
            <li>Go</li>
          </ul>
        </article>

        <article class="fm-card fm-project-card fm-reveal">
          <a href="{{ '/work/' | url }}" class="fm-project-link" aria-label="Open Real-time Data Pipeline">
            {% lucide "squareArrowOutUpRight" %}
          </a>
          <h3>Real-time Data Pipeline</h3>
          <p>Event-driven data processing system handling 100K+ events/second with sub-second latency using Kafka and Flink.</p>
          <ul class="fm-tags">
            <li>Kafka</li>
            <li>Apache Flink</li>
            <li>PostgreSQL</li>
            <li>Python</li>
          </ul>
        </article>

        <article class="fm-card fm-project-card fm-reveal">
          <a href="{{ '/work/' | url }}" class="fm-project-link" aria-label="Open Developer Platform API">
            {% lucide "squareArrowOutUpRight" %}
          </a>
          <h3>Developer Platform API</h3>
          <p>GraphQL API gateway enabling third-party developers to build on our platform. Powers 500+ integrations.</p>
          <ul class="fm-tags">
            <li>GraphQL</li>
            <li>Node.js</li>
            <li>Redis</li>
            <li>MongoDB</li>
          </ul>
        </article>

        <article class="fm-card fm-project-card fm-reveal">
          <a href="{{ '/work/' | url }}" class="fm-project-link" aria-label="Open Machine Learning Inference Engine">
            {% lucide "squareArrowOutUpRight" %}
          </a>
          <h3>Machine Learning Inference Engine</h3>
          <p>High-performance ML model serving infrastructure with automatic scaling and A/B testing capabilities.</p>
          <ul class="fm-tags">
            <li>TensorFlow</li>
            <li>Kubernetes</li>
            <li>gRPC</li>
            <li>Python</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

