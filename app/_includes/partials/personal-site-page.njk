<div class="fm-page">
  <section id="hero" class="fm-hero" aria-labelledby="hero-title">
    {% if seasonalScene %}
      {# Seasonal scene slot "hero": a scene's ambient layer mounts here. #}
      <div class="fm-scene-slot" data-scene-slot="hero" aria-hidden="true"></div>
    {% endif %}
    {# Seasonal scene hook "copy": the text an ambient layer is drawn behind. #}
    <div class="fm-hero-content" data-scene-copy>
      <h1 id="hero-title" class="fm-name" data-scene-accent="name">Igor Cheliadinski</h1>
      <p class="fm-tagline">{{ site.hero.tagline }}</p>
      <p class="fm-hero-meta">Based in {{ site.location }}</p>
      <nav class="fm-hero-links" aria-label="Hero links">
        <a href="#projects">View Work</a>
        <span aria-hidden="true">•</span>
        <a href="mailto:{{ site.email }}">{{ site.email }}</a>
      </nav>
    </div>
    <a href="#projects" class="fm-scroll-down">
      {% lucide "chevronDown" %}
      <span class="fm-visually-hidden">Scroll to selected work</span>
    </a>
  </section>

  <section id="projects" class="fm-section" aria-labelledby="projects-title">
    <div class="fm-container">
      <header class="fm-section-head fm-reveal">
        <h2 id="projects-title" data-scene-accent="heading">Selected Work</h2>
        <p>Projects spanning product engineering, frontend architecture, and systems thinking. Previews are illustrative sketches, not production code.</p>
      </header>

      <div class="fm-grid fm-grid-two">
        {% for project in projects %}
        <article class="fm-card fm-project-card fm-reveal">
          <h3>{{ project.title }}</h3>
          {% if project.preview %}
            {% include "partials/project-preview.njk" %}
          {% endif %}
          <p>{{ project.description }}</p>
          <ul class="fm-tags" aria-label="Stack">
            {% for tag in project.tags.slice(0, 4) %}
            <li>{{ tag }}</li>
            {% endfor %}
          </ul>
          <div class="fm-project-card-foot">
            {% if project.ask %}
              <a href="mailto:{{ site.email }}?subject={{ ('About ' + project.name) | urlencode }}" class="fm-project-link">
                <span class="fm-project-link-icon" aria-hidden="true">{% lucide "mail" %}</span>
                <span class="fm-project-link-text">Ask about it</span>
                <span class="fm-visually-hidden"> by email: {{ project.name }}</span>
              </a>
            {% else %}
              <a href="{{ project.url }}" target="_blank" rel="noopener noreferrer" class="fm-project-link">
                <span class="fm-project-link-text">{{ project.linkText }}</span>
                <span class="fm-project-link-icon" aria-hidden="true">{% lucide "squareArrowOutUpRight" %}</span>
                <span class="fm-visually-hidden"> for {{ project.name }} (opens in a new tab)</span>
              </a>
            {% endif %}
          </div>
        </article>
        {% endfor %}
      </div>
    </div>
  </section>

  <section id="timeline" class="fm-section" aria-labelledby="timeline-title">
    <div class="fm-container">
      <header class="fm-section-head fm-reveal">
        <h2 id="timeline-title" data-scene-accent="heading">Career Journey</h2>
        <p>Building digital products and engineering systems since 2014</p>
      </header>

      <div class="fm-timeline-shell">
        <span class="fm-timeline-line" aria-hidden="true"></span>
        <span class="fm-timeline-progress" data-timeline-progress aria-hidden="true"></span>
        <ol class="fm-timeline" data-timeline>
          {% for item in timeline %}
          <li class="fm-timeline-item {% if loop.index0 % 2 == 0 %}fm-timeline-item-left{% else %}fm-timeline-item-right{% endif %} fm-reveal">
            <div class="fm-timeline-copy">
              <p class="fm-year">{{ item.year }}</p>
              <h3>{{ item.title }}</h3>
              <p>{{ item.description }}</p>
            </div>
            <span class="fm-timeline-dot" aria-hidden="true"></span>
          </li>
          {% endfor %}
        </ol>
      </div>
    </div>
  </section>

  <section id="writing" class="fm-section" aria-labelledby="writing-title">
    <div class="fm-container fm-narrow">
      <header class="fm-section-head fm-reveal">
        <h2 id="writing-title" data-scene-accent="heading">Writing &amp; Notes</h2>
        <p>Ideas on systems, product engineering, and practical frontend work</p>
      </header>

      <ul class="fm-writing-list">
        {% for article in writing.articles %}
          <li class="fm-reveal">
            <a href="{{ article.url }}" target="_blank" rel="noopener noreferrer">
              <span>
                <strong>{{ article.title }}</strong>
                <small>
                  <span aria-hidden="true">{% lucide "calendar" %}</span>
                  {{ article.dateLabel }}
                  {% if article.detail %}
                    <span class="fm-dot-sep" aria-hidden="true">•</span>
                    {{ article.detail }}
                  {% endif %}
                </small>
              </span>
              <span class="fm-visually-hidden"> (opens in a new tab)</span>
              <span class="fm-arrow" aria-hidden="true">{% lucide "arrowRight" %}</span>
            </a>
          </li>
        {% else %}
          <li class="fm-reveal">
            <a href="{{ site.writing.fallbackUrl }}" target="_blank" rel="noopener noreferrer">
              <span>
                <strong>Latest writing on the blog</strong>
                <small>
                  <span aria-hidden="true">{% lucide "calendar" %}</span>
                  Updated regularly
                  <span class="fm-dot-sep" aria-hidden="true">•</span>
                  Notes and articles
                </small>
              </span>
              <span class="fm-visually-hidden"> (opens in a new tab)</span>
              <span class="fm-arrow" aria-hidden="true">{% lucide "arrowRight" %}</span>
            </a>
          </li>
        {% endfor %}
      </ul>
    </div>
  </section>

  <section id="contact" class="fm-section fm-contact-section" aria-labelledby="contact-title">
    <div class="fm-container fm-contact-wrap">
      <header class="fm-section-head fm-reveal">
        <h2 id="contact-title" data-scene-accent="heading">Get in Touch</h2>
        <p>{{ site.availability }}</p>
      </header>

      <p class="fm-contact-intro fm-reveal">
        I focus on outcomes, not stacks: turning constraints, context, and intent into software that is maintainable, predictable, and useful.
      </p>

      <ul class="fm-contact-list">
        {% for contact in contacts %}
        <li class="fm-reveal">
          <a href="{{ contact.href }}"{% if contact.external %} target="_blank" rel="noopener noreferrer"{% endif %}>
            <span class="fm-contact-icon" aria-hidden="true">
              {% lucide contact.icon %}
            </span>
            <span><small>{{ contact.label }}</small><span class="fm-visually-hidden">: </span><strong>{{ contact.value }}</strong>{% if contact.external %}<span class="fm-visually-hidden"> (opens in a new tab)</span>{% endif %}</span>
          </a>
        </li>
        {% endfor %}
      </ul>
    </div>
  </section>
</div>
