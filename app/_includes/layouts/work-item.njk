---
layout: layouts/base.njk
---
<article class="section container">
  <p class="eyebrow">Case Study</p>
  <h1>{{ title }}</h1>
  <p class="section-subtitle">{{ summary }}</p>
  <p><strong>Role:</strong> {{ role }} · <strong>Stack:</strong> <span class="tech-text">{{ stack }}</span></p>
  <div>{{ content | safe }}</div>
  {% if link %}
    <p>
      <a class="btn btn-primary" href="{{ link }}" target="_blank" rel="noopener noreferrer">Visit project</a>
    </p>
  {% endif %}
  <p><a href="{{ '/work/' | url }}">Back to work</a></p>
</article>
