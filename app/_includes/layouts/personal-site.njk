<!doctype html>
<html
  lang="{{ site.language }}"
  data-theme-color-light="{{ site.themeColorLight }}"
  data-theme-color-dark="{{ site.themeColorDark }}"
>
  <head>
    {% set pageTitle = title or site.name %}
    {% set pageDescription = description or site.description %}
    {% set canonicalUrl = (site.url + page.url) | url %}
    {% set socialImagePath = seoImage or site.socialImage %}
    {% set socialImageUrl = (site.url + socialImagePath) | url %}
    {% set robotsContent = "noindex, nofollow" if noindex else "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" %}
    {% set isHomepage = page.url == "/" %}
    {% set includeDefaultJs = not skipDefaultJs %}
    {# Seasonal scenes are switched on per page by `seasonalScene: true` in
       front matter. A page without a scene's slot gets that scene's content
       accents alone, and a scene with nothing to show there is left out. #}
    {% set pageScenes = scenes.forPage(content) if seasonalScene else { hasScenes: false } %}
    {% set sceneMachinery = pageScenes.hasScenes %}

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="{{ site.themeColorDark }}" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="{{ site.themeColorLight }}" media="(prefers-color-scheme: light)" />
    <meta name="author" content="{{ site.author }}" />
    <meta name="description" content="{{ pageDescription }}" />
    <meta name="robots" content="{{ robotsContent }}" />
    <meta name="googlebot" content="{{ robotsContent }}" />
    {% if site.googleSiteVerification %}
      <meta name="google-site-verification" content="{{ site.googleSiteVerification }}" />
    {% endif %}
    {% if site.bingSiteVerification %}
      <meta name="msvalidate.01" content="{{ site.bingSiteVerification }}" />
    {% endif %}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{% if pageTitle == site.name %}{{ site.name }}{% else %}{{ pageTitle }} | {{ site.name }}{% endif %}</title>
    <link rel="canonical" href="{{ canonicalUrl }}" />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="{{ '/sitemap.xml' | url }}" />
    <link rel="alternate" type="application/feed+json" title="{{ site.name }} Writing" href="https://blog.igorcodes.dev/feed.json" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="{{ site.name }}" />
    <meta property="og:locale" content="{{ site.locale }}" />
    <meta property="og:title" content="{{ pageTitle }}" />
    <meta property="og:description" content="{{ pageDescription }}" />
    <meta property="og:url" content="{{ canonicalUrl }}" />
    <meta property="og:image" content="{{ socialImageUrl }}" />
    <meta property="og:image:secure_url" content="{{ socialImageUrl }}" />
    <meta property="og:image:alt" content="{{ site.socialImageAlt }}" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ pageTitle }}" />
    <meta name="twitter:description" content="{{ pageDescription }}" />
    <meta name="twitter:image" content="{{ socialImageUrl }}" />
    <meta name="twitter:image:alt" content="{{ site.socialImageAlt }}" />
    {% if site.twitterHandle %}
      <meta name="twitter:site" content="{{ site.twitterHandle }}" />
      <meta name="twitter:creator" content="{{ site.twitterHandle }}" />
    {% endif %}
    <link rel="icon" href="{{ site.faviconIco | url }}" sizes="any" />
    <link rel="icon" type="image/png" href="{{ site.faviconPng | url }}" sizes="32x32" />
    <link rel="apple-touch-icon" href="{{ site.appleTouchIcon | url }}" sizes="180x180" />
    <link
      rel="preload"
      href="{{ '/fonts/wotfard/wotfard-medium-webfont.woff2' | url }}"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {% if not noindex %}
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@graph": [
            {
              "@type": "Person",
              "@id": "{{ site.url }}#person",
              "name": {{ site.author | dump | safe }},
              "url": "{{ site.url }}",
              "jobTitle": {{ site.person.jobTitle | dump | safe }},
              "description": {{ site.person.description | dump | safe }},
              "image": "{{ (site.url + site.profileImage) | url }}",
              "email": {{ ("mailto:" + site.email) | dump | safe }},
              "knowsAbout": {{ site.person.knowsAbout | dump | safe }},
              "homeLocation": {
                "@type": "Place",
                "address": {
                  "@type": "PostalAddress",
                  "addressLocality": {{ site.person.addressLocality | dump | safe }},
                  "addressRegion": {{ site.person.addressRegion | dump | safe }},
                  "addressCountry": {{ site.person.addressCountry | dump | safe }}
                }
              },
              "worksFor": {
                "@type": "Organization",
                "name": "Independent"
              },
              "sameAs": {{ site.sameAs | dump | safe }}
            },
            {
              "@type": "WebSite",
              "@id": "{{ site.url }}#website",
              "url": "{{ site.url }}",
              "name": {{ site.name | dump | safe }},
              "description": {{ site.description | dump | safe }},
              "publisher": {
                "@type": "Organization",
                "name": {{ site.name | dump | safe }},
                "logo": {
                  "@type": "ImageObject",
                  "url": "{{ (site.url + site.logo) | url }}"
                }
              },
              "inLanguage": "{{ site.language }}"
            },
            {
              "@type": "WebPage",
              "@id": "{{ canonicalUrl }}#webpage",
              "url": "{{ canonicalUrl }}",
              "name": {{ pageTitle | dump | safe }},
              "description": {{ pageDescription | dump | safe }},
              "isPartOf": {
                "@id": "{{ site.url }}#website"
              },
              "about": {
                "@id": "{{ site.url }}#person"
              },
              "primaryImageOfPage": {
                "@type": "ImageObject",
                "url": "{{ socialImageUrl }}"
              },
              "dateModified": "{{ site.contentUpdated }}",
              "inLanguage": "{{ site.language }}"
            }{% if isHomepage %},
            {
              "@type": "ProfilePage",
              "@id": "{{ site.url }}#profile",
              "url": "{{ site.url }}",
              "name": {{ (site.name + " | Personal Website") | dump | safe }},
              "mainEntity": {
                "@id": "{{ site.url }}#person"
              },
              "dateModified": "{{ site.contentUpdated }}"
            }{% endif %}
          ]
        }
      </script>
    {% endif %}
    <script>
      // Runs pre-paint to avoid a theme flash. Deliberately duplicated with
      // personal-site.js — both must agree on the "fm-theme" storage key and the
      // default-dark behavior.
      (() => {
        const storageKey = "fm-theme";
        const root = document.documentElement;
        const lightColor = "{{ site.themeColorLight }}";
        const darkColor = "{{ site.themeColorDark }}";

        const getPreferredTheme = () => {
          let storedTheme = null;

          try {
            storedTheme = window.localStorage.getItem(storageKey);
          } catch {}

          if (storedTheme === "light" || storedTheme === "dark") {
            return storedTheme;
          }

          return window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        };

        const theme = getPreferredTheme();
        root.dataset.theme = theme;
        root.style.colorScheme = theme;

        const color = theme === "light" ? lightColor : darkColor;
        document.querySelectorAll('meta[name="theme-color"]').forEach((meta) => {
          meta.removeAttribute("media");
          meta.setAttribute("content", color);
        });
      })();
    </script>
    {% if sceneMachinery %}
      <script>
        // Picks the seasonal scene pre-paint, so a visitor who switched scenes
        // off never sees one flash. Sets data-scene (and data-occasions) on
        // <html> only when a scene is showing; no attribute means the plain
        // site. Must agree with personal-site.js on the "fm-scene" storage
        // key. The date table comes from _data/seasons.js and the picker
        // functions from _tools/season-clock.js.
        (() => {
          {{ scenes.clockSource | safe }}

          const table = {{ seasons | dump | safe }};
          const scenes = {{ pageScenes.client | dump | safe }};
          const storageKey = "fm-scene";
          const root = document.documentElement;
          const params = new URLSearchParams(window.location.search);
          const now = new Date();
          const month = now.getMonth() + 1;
          const day = now.getDate();

          // ?season= and ?occasion= preview one page view; nothing is stored.
          let season = currentSeason(table.starts, month, day);
          const previewSeason = params.get("season");
          if (previewSeason !== null && Object.hasOwn(table.starts, previewSeason)) {
            season = previewSeason;
          }

          if (!Object.hasOwn(scenes, season)) {
            return;
          }

          const occasions = currentOccasions(table.occasions, season, month, day);
          const previewOccasion = params.get("occasion");
          const isPreviewable = table.occasions.some(
            (occasion) => occasion.name === previewOccasion && occasion.season === season,
          );
          if (isPreviewable && !occasions.includes(previewOccasion)) {
            occasions.push(previewOccasion);
          }

          // Read by personal-site.js, which owns everything after first paint.
          window.__fmScene = { season, occasions, ...scenes[season] };

          if (window.matchMedia("(forced-colors: active)").matches) {
            return;
          }

          let storedChoice = null;
          try {
            storedChoice = window.localStorage.getItem(storageKey);
          } catch {}

          if (storedChoice === "off") {
            return;
          }

          root.dataset.scene = season;
          if (occasions.length > 0) {
            root.dataset.occasions = occasions.join(" ");
          }
        })();
      </script>
    {% endif %}
    <style>
      {{ criticalCss | safe }}
    </style>
    {% if deferStylesheet %}
      {# Only for pages whose first viewport the inlined critical CSS fully
         styles (the homepage hero). The full sheet then loads without
         blocking first paint, so personal-site.js can run before it applies;
         it finds this link by data-deferred-stylesheet to wait for it. #}
      <link
        rel="preload"
        as="style"
        href="{{ assets.css | url }}"
        data-deferred-stylesheet
        onload="this.onload=null;this.rel='stylesheet'"
      />
      <noscript><link rel="stylesheet" href="{{ assets.css | url }}" /></noscript>
    {% else %}
      <link rel="stylesheet" href="{{ assets.css | url }}" />
    {% endif %}
    {% if sceneMachinery %}
      {# Dev server only: production appends every accents.css to the full
         stylesheet and bundles three.js into each scene. #}
      {% for scene in scenes.list %}
        {% if scene.accentsCss %}
          <link rel="stylesheet" href="{{ scene.accentsCss | url }}" />
        {% endif %}
      {% endfor %}
      {% if pageScenes.devModules %}
        <script type="importmap">
          {
            "imports": {
              "three": "{{ '/assets/vendor/three/three.module.js' | url }}",
              "three/addons/": "{{ '/assets/vendor/three-addons/' | url }}"
            }
          }
        </script>
      {% endif %}
    {% endif %}
    {% if notFoundPage and assets.notFoundCss %}
      <link rel="stylesheet" href="{{ assets.notFoundCss | url }}" />
    {% endif %}
    {% if site.umami and site.umami.websiteId %}
      <script
        defer
        src="{{ site.umami.scriptUrl }}"
        data-website-id="{{ site.umami.websiteId }}"
        data-domains="{{ site.umami.domains }}"
        data-do-not-track="{{ 'true' if site.umami.respectDoNotTrack else 'false' }}"
      ></script>
    {% endif %}
  </head>
  <body class="fm-body">
    <a class="fm-skip-link" href="#content">Skip to content</a>
    <main id="content" tabindex="-1">{{ content | safe }}</main>
    <footer class="fm-footer">
      <div class="fm-container fm-footer-inner">
        <p>© {{ build.year }} {{ site.name }}. All rights reserved.</p>
      </div>
    </footer>
    {% if sceneMachinery %}
      {# Season control. Hidden until personal-site.js finds a scene for the
         current season; it then shows that scene's icon. #}
      <button
        class="fm-theme-toggle fm-season-toggle"
        type="button"
        data-season-toggle
        role="switch"
        aria-label="Seasonal scene"
        aria-checked="false"
        hidden
      >
        <span class="fm-theme-toggle-shell" aria-hidden="true">
          {% for scene in scenes.list %}
            <span class="fm-theme-toggle-icon fm-season-toggle-icon" data-season-icon="{{ scene.season }}" hidden>
              {% lucide scene.icon %}
            </span>
          {% endfor %}
        </span>
      </button>
    {% endif %}
    <button
      class="fm-theme-toggle"
      type="button"
      data-theme-toggle
      role="switch"
      aria-label="Light theme"
      aria-checked="false"
    >
      <span class="fm-theme-toggle-shell" aria-hidden="true">
        <span class="fm-theme-toggle-icon fm-theme-toggle-icon-sun">
          <svg viewBox="0 0 24 24" focusable="false">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2"></path>
            <path d="M12 20v2"></path>
            <path d="m4.93 4.93 1.41 1.41"></path>
            <path d="m17.66 17.66 1.41 1.41"></path>
            <path d="M2 12h2"></path>
            <path d="M20 12h2"></path>
            <path d="m6.34 17.66-1.41 1.41"></path>
            <path d="m19.07 4.93-1.41 1.41"></path>
          </svg>
        </span>
        <span class="fm-theme-toggle-icon fm-theme-toggle-icon-moon">
          <svg viewBox="0 0 24 24" focusable="false">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
          </svg>
        </span>
      </span>
    </button>
    {% if includeDefaultJs %}
      <script src="{{ assets.js | url }}" defer></script>
    {% endif %}
    {% if notFoundPage and assets.notFoundJs %}
      <script src="{{ assets.notFoundJs | url }}" defer></script>
    {% endif %}
  </body>
</html>
