<!doctype html>
<html lang="{{ site.language }}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0a" />
    <title>{% if title %}{{ title }} | {% endif %}{{ site.name }}</title>
    <meta name="description" content="{{ description or site.description }}" />
    <link rel="canonical" href="{{ (site.url + page.url) | url }}" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="{{ site.name }}" />
    <meta property="og:title" content="{{ title or site.name }}" />
    <meta property="og:description" content="{{ description or site.description }}" />
    <meta property="og:url" content="{{ (site.url + page.url) | url }}" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ title or site.name }}" />
    <meta name="twitter:description" content="{{ description or site.description }}" />
    <link
      rel="preload"
      href="{{ '/fonts/wotfard/wotfard-regular-webfont.woff2' | url }}"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="stylesheet" href="{{ assets.css | url }}" />
  </head>
  <body class="fm-body">
    <main id="content">{{ content | safe }}</main>
    <script src="{{ assets.js | url }}" defer></script>
  </body>
</html>
