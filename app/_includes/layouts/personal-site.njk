<!doctype html>
<html lang="{{ site.language }}">
  <head>
    {% set pageTitle = title or site.name %}
    {% set pageDescription = description or site.description %}
    {% set canonicalUrl = (site.url + page.url) | url %}
    {% set socialImagePath = seoImage or site.socialImage %}
    {% set socialImageUrl = (site.url + socialImagePath) | url %}
    {% set robotsContent = "noindex, nofollow" if noindex else "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" %}
    {% set isHomepage = page.url == "/" %}
    {% set includeDefaultJs = not skipDefaultJs %}

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="{{ site.themeColorDark }}" />
    <meta name="author" content="{{ site.author }}" />
    <meta name="description" content="{{ pageDescription }}" />
    <meta name="robots" content="{{ robotsContent }}" />
    <meta name="googlebot" content="{{ robotsContent }}" />
    {% if site.googleSiteVerification %}
      <meta name="google-site-verification" content="{{ site.googleSiteVerification }}" />
    {% endif %}
    {% if site.bingSiteVerification %}
      <meta name="msvalidate.01" content="{{ site.bingSiteVerification }}" />
    {% endif %}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{% if pageTitle == site.name %}{{ site.name }}{% else %}{{ pageTitle }} | {{ site.name }}{% endif %}</title>
    <link rel="canonical" href="{{ canonicalUrl }}" />
    <link rel="alternate" hreflang="{{ site.language }}" href="{{ canonicalUrl }}" />
    <link rel="alternate" hreflang="x-default" href="{{ (site.url + '/') | url }}" />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="{{ '/sitemap.xml' | url }}" />
    <link rel="alternate" type="application/rss+xml" title="{{ site.name }} Feed" href="{{ '/feed.xml' | url }}" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="{{ site.name }}" />
    <meta property="og:locale" content="{{ site.locale }}" />
    <meta property="og:title" content="{{ pageTitle }}" />
    <meta property="og:description" content="{{ pageDescription }}" />
    <meta property="og:url" content="{{ canonicalUrl }}" />
    <meta property="og:image" content="{{ socialImageUrl }}" />
    <meta property="og:image:secure_url" content="{{ socialImageUrl }}" />
    <meta property="og:image:alt" content="{{ site.socialImageAlt }}" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ pageTitle }}" />
    <meta name="twitter:description" content="{{ pageDescription }}" />
    <meta name="twitter:image" content="{{ socialImageUrl }}" />
    <meta name="twitter:image:alt" content="{{ site.socialImageAlt }}" />
    {% if site.twitterHandle %}
      <meta name="twitter:site" content="{{ site.twitterHandle }}" />
      <meta name="twitter:creator" content="{{ site.twitterHandle }}" />
    {% endif %}
    <link rel="icon" href="{{ site.faviconIco | url }}" sizes="any" />
    <link rel="icon" type="image/png" href="{{ site.faviconPng | url }}" sizes="32x32" />
    <link rel="apple-touch-icon" href="{{ site.appleTouchIcon | url }}" sizes="180x180" />
    <link
      rel="preload"
      href="{{ '/fonts/wotfard/wotfard-regular-webfont.woff2' | url }}"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {% if not noindex %}
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@graph": [
            {
              "@type": "Person",
              "@id": "{{ site.url }}#person",
              "name": "{{ site.author }}",
              "url": "{{ site.url }}",
              "jobTitle": "Software Engineer",
              "image": "{{ (site.url + site.profileImage) | url }}",
              "worksFor": {
                "@type": "Organization",
                "name": "Independent"
              },
              "sameAs": [{% for profile in site.sameAs %}"{{ profile }}"{% if not loop.last %}, {% endif %}{% endfor %}]
            },
            {
              "@type": "WebSite",
              "@id": "{{ site.url }}#website",
              "url": "{{ site.url }}",
              "name": "{{ site.name }}",
              "description": "{{ site.description }}",
              "publisher": {
                "@type": "Organization",
                "name": "{{ site.name }}",
                "logo": {
                  "@type": "ImageObject",
                  "url": "{{ (site.url + site.logo) | url }}"
                }
              },
              "inLanguage": "{{ site.language }}"
            },
            {
              "@type": "WebPage",
              "@id": "{{ canonicalUrl }}#webpage",
              "url": "{{ canonicalUrl }}",
              "name": "{{ pageTitle }}",
              "description": "{{ pageDescription }}",
              "isPartOf": {
                "@id": "{{ site.url }}#website"
              },
              "about": {
                "@id": "{{ site.url }}#person"
              },
              "primaryImageOfPage": {
                "@type": "ImageObject",
                "url": "{{ socialImageUrl }}"
              },
              "dateModified": "{{ build.isoDateTime }}",
              "inLanguage": "{{ site.language }}"
            }{% if isHomepage %},
            {
              "@type": "ProfilePage",
              "@id": "{{ site.url }}#profile",
              "url": "{{ site.url }}",
              "name": "{{ site.name }} | Personal Website",
              "mainEntity": {
                "@id": "{{ site.url }}#person"
              },
              "dateModified": "{{ build.isoDateTime }}"
            }{% endif %}
          ]
        }
      </script>
    {% endif %}
    <script>
      (() => {
        const storageKey = "fm-theme";
        const root = document.documentElement;
        const themeColorMeta = document.querySelector('meta[name="theme-color"]');
        const lightColor = "{{ site.themeColorLight }}";
        const darkColor = "{{ site.themeColorDark }}";

        const getPreferredTheme = () => {
          let storedTheme = null;

          try {
            storedTheme = window.localStorage.getItem(storageKey);
          } catch {}

          if (storedTheme === "light" || storedTheme === "dark") {
            return storedTheme;
          }

          return window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        };

        const theme = getPreferredTheme();
        root.dataset.theme = theme;
        root.style.colorScheme = theme;

        if (themeColorMeta) {
          themeColorMeta.setAttribute("content", theme === "light" ? lightColor : darkColor);
        }
      })();
    </script>
    <style>
      {{ criticalCss | safe }}
    </style>
    <link rel="preload" href="{{ assets.css | url }}" as="style" />
    <link rel="stylesheet" href="{{ assets.css | url }}" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="{{ assets.css | url }}" />
    </noscript>
    {% if notFoundPage and assets.notFoundCss %}
      <link rel="stylesheet" href="{{ assets.notFoundCss | url }}" />
    {% endif %}
    {% if site.umami and site.umami.websiteId %}
      <script
        defer
        src="{{ site.umami.scriptUrl }}"
        data-website-id="{{ site.umami.websiteId }}"
        data-domains="{{ site.umami.domains }}"
        data-do-not-track="{{ 'true' if site.umami.respectDoNotTrack else 'false' }}"
      ></script>
    {% endif %}
  </head>
  <body class="fm-body">
    <a class="fm-skip-link" href="#content">Skip to content</a>
    <button
      class="fm-theme-toggle"
      type="button"
      data-theme-toggle
      role="switch"
      aria-label="Light theme"
      aria-checked="false"
      aria-describedby="theme-toggle-status"
    >
      <span class="fm-theme-toggle-shell" aria-hidden="true">
        <span class="fm-theme-toggle-icon fm-theme-toggle-icon-sun">
          <svg viewBox="0 0 24 24" focusable="false">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2"></path>
            <path d="M12 20v2"></path>
            <path d="m4.93 4.93 1.41 1.41"></path>
            <path d="m17.66 17.66 1.41 1.41"></path>
            <path d="M2 12h2"></path>
            <path d="M20 12h2"></path>
            <path d="m6.34 17.66-1.41 1.41"></path>
            <path d="m19.07 4.93-1.41 1.41"></path>
          </svg>
        </span>
        <span class="fm-theme-toggle-icon fm-theme-toggle-icon-moon">
          <svg viewBox="0 0 24 24" focusable="false">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
          </svg>
        </span>
      </span>
      <span class="fm-visually-hidden" id="theme-toggle-status" data-theme-toggle-status>
        Dark theme active. Activate to switch to light theme.
      </span>
    </button>
    <main id="content" tabindex="-1">{{ content | safe }}</main>
    {% if includeDefaultJs %}
      <script src="{{ assets.js | url }}" defer></script>
    {% endif %}
    {% if notFoundPage and assets.notFoundJs %}
      <script src="{{ assets.notFoundJs | url }}" defer></script>
    {% endif %}
  </body>
</html>
