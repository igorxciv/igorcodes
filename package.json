{
  "name": "igorxciv",
  "version": "1.0.0",
  "private": true,
  "description": "Eleventy static single-page personal site",
  "scripts": {
    "dev": "eleventy --serve",
    "build": "npm run build:assets && NODE_ENV=production eleventy",
    "build:assets": "NODE_ENV=production node app/_tools/build-assets.mjs",
    "clean": "rm -rf _site .cache .11ty-cache app/assets/build app/_data/assets-manifest.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20.11"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.2",
    "@eslint/js": "9.39.4",
    "esbuild": "0.27.3",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.4.0",
    "html-minifier-terser": "7.2.0",
    "husky": "9.1.7",
    "lightningcss": "1.32.0",
    "lint-staged": "16.3.3",
    "prettier": "3.8.1"
  },
  "dependencies": {
    "lucide": "0.577.0"
  }
}
