{
  "name": "igorxciv",
  "version": "1.0.0",
  "private": true,
  "description": "Eleventy static single-page personal site",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "eleventy --serve",
    "build": "pnpm run fonts:fetch && pnpm run build:assets && NODE_ENV=production eleventy",
    "build:assets": "NODE_ENV=production node app/_tools/build-assets.mjs",
    "fonts:fetch": "node app/_tools/fetch-fonts.mjs",
    "fonts:upload": "node app/_tools/upload-fonts.mjs",
    "clean": "rm -rf _site .cache .11ty-cache app/assets/build app/_data/assets-manifest.json",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "prepare": "lefthook install"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "26.x"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.8",
    "@11ty/eleventy-fetch": "6.0.1",
    "@biomejs/biome": "2.6.6",
    "@vercel/blob": "^2.8.2",
    "html-minifier-terser": "7.2.0",
    "lefthook": "2.2.2",
    "lightningcss": "1.33.0",
    "lucide": "1.70.0",
    "rolldown": "1.3.0",
    "three": "0.187.0"
  }
}
