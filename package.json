{
  "name": "igorxciv",
  "version": "1.0.0",
  "private": true,
  "description": "Eleventy static single-page personal site",
  "scripts": {
    "dev": "eleventy --serve",
    "build": "npm run build:assets && NODE_ENV=production eleventy",
    "build:assets": "NODE_ENV=production node app/_tools/build-assets.mjs",
    "clean": "rm -rf _site .cache .11ty-cache app/assets/build app/_data/assets-manifest.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "engines": {
    "node": "^20.19.0 || >=22.13.0"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.5",
    "@11ty/eleventy-fetch": "5.1.3",
    "@eslint/js": "10.0.1",
    "esbuild": "0.28.0",
    "eslint": "10.2.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.5.0",
    "html-minifier-terser": "7.2.0",
    "husky": "9.1.7",
    "lightningcss": "1.32.0",
    "lint-staged": "16.4.0",
    "lucide": "1.8.0",
    "prettier": "3.8.2"
  }
}
